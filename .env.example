# Anthropic Claude API — consíguelo en console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Base de datos PostgreSQL (Neon via Vercel)
# En local puedes usar: postgresql://user:password@localhost:5432/financeai
# En Vercel: se añade automáticamente al conectar la base de datos Neon
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
